# ─────────────────────────────────────────────────────────────────────────────
# The Xperience Assistant — Environment Variables
# Copy this file to .env and fill in real values before starting the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info          # error | warn | info | http | verbose | debug | silly

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Full connection string including credentials and cluster
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_tokens
JWT_ACCESS_EXPIRY=15m

JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRY=7d

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one provider and supply its API key.
# Supported: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro        # Override the default model for this provider
LLM_TIMEOUT_MS=30000            # Milliseconds before an LLM call times out

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (leave blank if not using)
OPENAI_API_KEY=

# Anthropic (leave blank if not using)
ANTHROPIC_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
