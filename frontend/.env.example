# Xperience Frontend — Environment Variables
# Copy this file to .env and fill in the values.
#
# In development the Vite proxy forwards /api → http://localhost:5000
# so you can leave VITE_API_BASE_URL as /api/v1 (relative URL).
# In production, set it to the full backend URL.

# Relative (works with the Vite proxy — recommended for development)
VITE_API_BASE_URL=/api/v1

# OR absolute (for production / if you disable the proxy)
# VITE_API_BASE_URL=https://api.yourapp.com/api/v1
VITE_API_BASE_URL=https://xperience-world-backend.onrender.com/api/v1
